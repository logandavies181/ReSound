global record ReSound
  -- All the methods chain

  --- Instrument names must be unique, but different instruments may load the same preset file.
  addInstrument: function(InstrumentConfig): ReSound

  addSample: function(SampleConfig): ReSound

  copyInstrument: function(sourceName: string, destName: string): ReSound

  setDefaultBpm: function(bpm: number): ReSound
  --- This is in terms of quarter notes, so 4/4 is just `4`. 5/8 is `1.25`.
  setDefaultMeter: function(barLength: number): ReSound

  --- Value is normalized to the inclusive 0..1 range. May also be called from EffectFn for per-sample automation.
  setParamValue: function(instrumentName: string, paramName: string, value: number): ReSound

  -- Adds chords to the state. The sequencer is responsible for determining which bar each Chord falls
  -- under, based on the starting bar (`PushChordsInput.at`) and the lengths of the preceding notes.
  -- The sequencer also must match the pushed notes against the correct instrument name.
  pushChords: function(instrumentName: string, {Chord}, PushChordsInput): ReSound
end

global record PushChordsInput
  at: number
  times: number|nil
end

-- Define the internal state, managed in the ReSound Host.
local record ReSoundConfig
  instruments: {InstrumentConfig}
  defaultBpm: number
  defaultMeter: number
end

-- Not part of the API, just here to silence lsp warnings.
local _: ReSoundConfig = {}

global record InstrumentConfig
  name: string
  plugin: string
  preset: string|nil -- Path to preset file. Only pass to plugin if present.
  volume: number|nil -- Defaults to 1
end

global record SampleConfig
  name: string
  path: string
  volume: number|nil -- Defaults to 1
end

global record Chord
  pitches: {Pitch}
  duration: Duration
  effectFn: EffectFn|nil
end

-- Called once per sample from note start through gate end, then once with playing=false for cleanup.
-- t is elapsed time in quarter notes since note start, starting at zero.
global type EffectFn = function(t: number, playing: boolean)

global record Duration
  --- How long the note lasts, in terms of quarter notes.
  length: number
  --- Actual gate duration. Used to allow simple interface for having notes continue to ring over subsequent notes.
  playLength: number|nil
end

global type DurationTuple = {number, number|nil}

--- Note
global n: function(Pitch, DurationTuple, ?EffectFn): Chord -- Just the note.

--- Octave
global o: function(Pitch, DurationTuple, ?EffectFn): Chord -- The note and the same note one octave higher.

--- Chord
global c: function({Pitch}, DurationTuple, ?EffectFn): Chord -- Just the notes.

--- Percussion (sample)
global p: function(DurationTuple, ?EffectFn): Chord -- No pitch, just the "x".

--- Rest
global r: function(DurationTuple, ?EffectFn): Chord -- No sounds, just used for adjusting timing.

-- From lib.tl
global strum: function(notes: {Pitch}, input: DurationTuple): {Chord}
global arpeggiate: function(notes: {Pitch}, input: DurationTuple, spacing: number): {Chord}
global straighten: function(input: {any}): {Chord}
-- End lib.tl

